# ── Postgres (async for app, sync-style for Alembic) ──
# Neon pooled connection — swap the host for your project.
DATABASE_URL=postgresql+asyncpg://promarket:promarket@localhost:5433/promarket
DATABASE_URL_SYNC=postgresql://promarket:promarket@localhost:5433/promarket

# ── Firebase Admin (server-side token verification) ──
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000"]

# ── SMS (self-hosted/open-source gateway; leave blank to no-op) ──
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
ADMIN_PHONE_NUMBER=""

# ── Web Push (VAPID) — generate with:
# python -c "from cryptography.hazmat.primitives.asymmetric import ec; import base64; k=ec.generate_private_key(ec.SECP256R1()); pn=k.private_numbers(); pu=k.public_key().public_numbers(); b=lambda d: base64.urlsafe_b64encode(d).rstrip(b'=').decode(); print('PUBLIC:', b(b'\x04'+pu.x.to_bytes(32,'big')+pu.y.to_bytes(32,'big'))); print('PRIVATE:', b(pn.private_value.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@promarket.dev"

# ── Debug ──
DEBUG=true
